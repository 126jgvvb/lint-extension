{
    "manifest_version":3,
    "name":"charged clicker v1.0",
    "version":"1.0",
    "permissions":["scripting","tabs","alarms","storage"],
    "host_permissions":["<all_urls>"],
    "background": {
        "service_worker": "scripts/background-job.js"
      },
    "content_scripts":[{
            "matches":["<all_urls>"],  
            "js":["scripts/content.js"]
    }],
    "action":{
        "default_popup":"pages/chargedClicker.html",
        "default_title":"charged clicker"
    }
}