{
    "manifest_version": 3,
    "name": "X-Linter Demo",
    "description": "X-Linter UI.",
    "version": "1.0",
    "permissions":["scripting","activeTab","tabs","alarms","storage"],
    "host_permissions":[
        "<all_urls>"
    ],
    "background": {
        "service_worker": "dist/background-job.js"
      },
    "content_scripts":[{
            "matches":["<all_urls>"],  
            "js":[
                "dist/content.js",
                "dist/modes.js",
                "dist/pop2.js",
                "dist/popup.js"
            ]
    }],
    "action": {
      "default_popup": "pages/modes.html",
      "default_title": "X-Linter"
    },
  "icons": {
    "16": "icons/icon16.png"
  },
  "web_accessible_resources": [
  {
    "resources": ["dist/config.json"],
    "matches": ["<all_urls>"]
  }
]

  }
  